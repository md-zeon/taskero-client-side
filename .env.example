# ============================================================
# Taskero - Frontend Environment Variables
# Copy this file to `.env.local` and fill in your own values.
#    cp .env.example .env.local   (macOS / Linux)
#    copy .env.example .env.local (Windows)
#
# Do NOT commit `.env.local` — it is gitignored.
# ============================================================

# --- Firebase configuration ---------------------------------
# Create a Firebase project at https://console.firebase.google.com
# then add a Web app and copy these values from the project settings.
# These variable names MUST match what is used in
# `src/firebase/firebase.init.js`.

VITE_FIREBASE_apiKey=your_api_key
VITE_FIREBASE_authDomain=your_project_id.firebaseapp.com
VITE_FIREBASE_projectId=your_project_id
VITE_FIREBASE_storageBucket=your_project_id.appspot.com
VITE_FIREBASE_messagingSenderId=your_sender_id
VITE_FIREBASE_appId=your_app_id

# --- Backend API URL ----------------------------------------
# Points the frontend at your Node/Express API.
# Leave empty to use the default production URL
# (https://taskero-server.vercel.app).
# For local development, start the server side and set:
VITE_API_URL=http://localhost:5000
